# Konnect API. Copy to .env for local work; in production these live in Render's environment.
NODE_ENV=development
PORT=4000
# The public origin, used for the M-Pesa callback URL and links in texts.
PUBLIC_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# Postgres. Leave unset locally to use the embedded database in .local/pglite.
# Production: the konnect schema in the Fpesa Supabase project, as role konnect_api,
# through the session pooler:
# postgresql://konnect_api.mrsxvdxaoogamhkdqejp:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

JWT_SECRET=<48+ random characters>
JWT_EXPIRES_IN=30d
# 32 bytes as 64 hex characters; encrypts admin authenticator secrets.
MASTER_KEY=<64 hex characters>
# Lets the first admin be created at /admin while none exists.
ADMIN_SETUP_TOKEN=<random string>

# M-Pesa (Daraja). Simulated: every prompt confirms itself after a few seconds, every
# payout is marked sent, and no money moves.
MPESA_DRIVER=simulated            # simulated | daraja
MPESA_ENV=sandbox                 # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TILL=                       # set for a Buy Goods till; leave empty for a Paybill
MPESA_CALLBACK_TOKEN=<random string, part of the callback URLs>

# M-Pesa B2C, which sends each host their 85% as soon as the guest pays. Needs a
# B2C-enabled shortcode with a funded balance. Without it, payouts wait in Admin > Payouts.
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_COMMAND=BusinessPayment

# Africa's Talking SMS. Without it, codes and texts are written to the log.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Defaults to on when SMS is configured.
PHONE_VERIFICATION=

# Cloudinary for photos (cloudinary://key:secret@cloud). Without it photos are kept in Postgres.
CLOUDINARY_URL=

# Seed and show the sample stays and treatments.
SAMPLE_CONTENT=on
